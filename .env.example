# Server-only Firebase Admin credentials for Admin → Users; never prefix with VITE_.
# The service-account project must match firebase-applet-config.json.
# Leave the database ID empty for the default Firestore database.
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
OPENROUTER_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DAILY_POST_OWNER_UIDS=
VITE_DAILY_QUESTIONS_ENABLED=false
