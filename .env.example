# Existing server-side OpenRouter key used only by Vercel functions. Do not expose it as a VITE_ variable.
# Portal-owned chat is pinned to Google AI Studio Gemma 4 31B; shared paper metadata
# analysis is pinned to Google AI Studio Gemini Flash Lite. Personal-key requests keep
# their student-selected model. No extra model variable is required.
OPENROUTER_API_KEY=

# A Firebase service-account JSON object for the HSC Portal Firebase project.
# Store the complete JSON as one protected Vercel environment variable; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional. This is the dedicated portal Firestore default database used when no override is supplied.
FIREBASE_FIRESTORE_DATABASE_ID=(default)
