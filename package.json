{
  "name": "hsc-portal",
  "productName": "HSC Portal",
  "private": true,
  "version": "1.0.0",
  "description": "HSC Portal desktop app for past-paper practice and study planning.",
  "author": "HSC Portal",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win nsis portable",
    "desktop:dir": "electron-builder --dir",
    "desktop:verify": "electron --version && electron-builder --version"
  },
  "build": {
    "appId": "app.hscportal.desktop",
    "productName": "HSC Portal",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-installer.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HSC Portal"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "firebase": "^12.16.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "vite": "^5.4.10",
    "vite-plugin-sitemap": "^0.8.1"
  },
  "overrides": {
    "jose": "5.10.0"
  }
}
