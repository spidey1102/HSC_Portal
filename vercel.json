{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/paper-metadata.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/standard_fonts/**"
    },
    "api/paper-metadata/worker.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/pdfjs-dist/standard_fonts/**"
    },
    "api/agent/paper-context.js": {
      "includeFiles": "node_modules/pdfjs-dist/standard_fonts/**"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "hscportal\\.vercel\\.app"
        }
      ],
      "destination": "https://www.hscportal.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
